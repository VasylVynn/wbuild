# ── Vitryna environment ──────────────────────────────────────────────────
# Copy this file to .env.local and put REAL values there. .env.local is
# gitignored — never commit real keys. After editing .env.local, restart
# `npm run dev` (env is read at server start).

# Local dev root domain (tenants = *.lvh.me). Production: vitryna.com.ua
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000
# Extra platform ROOT domains during brand-domain overlap (comma-separated,
# no ports). Each serves marketing + www. + app. — without this, a newly
# attached domain is treated as a tenant host and 404s. URL building and new
# tenant subdomains still use NEXT_PUBLIC_ROOT_DOMAIN only.
# NEXT_PUBLIC_EXTRA_PLATFORM_ROOTS=3minsite.com.ua

# ── Supabase ──  Dashboard → Project Settings → API Keys
# New 2025 key format: publishable (public, browser-safe) + secret (server-only).
# Legacy JWT keys (anon / service_role) also work if your project shows them.
# ВАЖЛИВО: the browser-safe key MUST be set under one of the two names below —
# without it the auth layer silently turns OFF and every tenant-ownership gate
# treats all visitors as members (degrade-open, brief §3.1). Fine locally,
# catastrophic in production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=          # sb_publishable_...  (public; legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY also accepted)
SUPABASE_SERVICE_ROLE_KEY=                      # sb_secret_...  OR legacy service_role JWT — SERVER-ONLY, bypasses RLS

# ── Admin (/admin — fail-CLOSED, lib/admin.ts) ──
# Comma-separated email allowlist. EMPTY or absent → /admin is unreachable for
# everyone (that's the safe default; there is no DB admin flag on purpose).
ADMIN_EMAILS=

# ── Anthropic ──  console.anthropic.com → Settings → API keys
# Needed for Phase 2 (generation) and Phase 3 (agent-chat). Server-only.
ANTHROPIC_API_KEY=

# ── Telegram (lead funnel, §5.6) ──  create ONE central bot via @BotFather:
# /newbot → name → username. Token is SERVER-ONLY. Username is public (t.me link).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=            # without @, e.g. vitryna_leads_bot
# Any long random string; passed to Telegram setWebhook and checked on every
# webhook call (X-Telegram-Bot-Api-Secret-Token). Generate: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# YOUR admin chat_id — «Хочу кастомні зміни» requests are pushed here (optional).
# Get it: message the bot, then check getUpdates, or reuse the id you bound earlier.
ADMIN_TELEGRAM_CHAT_ID=

# ── Apify (Instagram-first onboarding, wave E) ──  console.apify.com → Integrations
# Powers the "paste your Instagram link" import (profile scrape via the
# apify/instagram-profile-scraper actor, ~$0.01-0.05 per onboarding).
# ABSENT → the feature is silently off: the greeting never mentions Instagram
# and /api/ig-import refuses. Server-only.
APIFY_API_TOKEN=
# Overall scrape deadline in ms (default 150000).
# APIFY_TIMEOUT_MS=150000

# ── WayForPay (paid CUSTOM DOMAIN — publishing is free since 2026-08-06) ──
#    wayforpay.com → Merchant
# Until the real merchant is approved use WayForPay's public TEST merchant
# (see their docs: test_merch_n1 + its secret). Switching to production keys
# is env-only — no code changes. SERVER-ONLY secrets.
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_SECRET=
WAYFORPAY_MERCHANT_DOMAIN=        # e.g. wizz-app.net (shown on the pay page)
# Offer price in UAH (integer). The landing copy says 999 — keep in sync.
PRICE_UAH=999
# 1 = allow the TEST merchant in PRODUCTION. Its secret is published, so this
# lets anyone self-sign a paid callback. Тимчасово для ОДНОГО прод-смоуку —
# потім прибрати. Every credential read logs a loud error while it is set.
WAYFORPAY_ALLOW_TEST=

# ── Meta Pixel (platform funnel analytics only, never tenant sites) ──
# Absent → pixel is off everywhere (component renders nothing).
NEXT_PUBLIC_META_PIXEL_ID=

# ── PostHog (platform product analytics only, never tenant sites) ──
# ABSENT → analytics is fully off: posthog-js is never even downloaded and every
# capture/identify call no-ops (components/analytics/PostHogProvider.tsx).
# The SERVER mirror (lib/analytics/posthog-server.ts — funnel steps, payments,
# exceptions) deliberately reads this same key: a PostHog project key is
# write-only and meant to be public, and one key means browser and server events
# land on the same project and the same person. There is no separate server key.
NEXT_PUBLIC_POSTHOG_KEY=
# EU cloud by default — owners and their leads are Ukrainian, so the data stays
# in the EU. Override only to point at US cloud or a self-hosted instance.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
